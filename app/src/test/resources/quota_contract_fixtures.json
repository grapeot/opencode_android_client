      "body": "{\"generated_at\":\"2020-01-01T00:00:00\",\"quotas\":[{\"provider\":\"test-b\",\"label\":\"5h\",\"used_percentage\":11,\"remaining_percentage\":89,\"observed_at\":\"2023-11-14T22:13:19Z\"},{\"provider\":\"test-a\",\"label\":\"reset-string\",\"used_percentage\":11,\"remaining_percentage\":89,\"next_reset_time_ms\":\"not-millis\"},{\"provider\":\"test-a\",\"label\":\"usage-string\",\"used_percentage\":11,\"remaining_percentage\":89,\"usage\":\"not-a-count\"},{\"provider\":\"test-c\",\"label\":\"7d\",\"used_percentage\":22,\"remaining_percentage\":78,\"observed_at\":\"2023-11-14T22:13:19Z\"}]}",
      "expect": {
        "outcome": "success",
        "assertFresh": true,
        "items": [
