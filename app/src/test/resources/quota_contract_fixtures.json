    {
      "id": "empty_quotas_succeeds",
      "coverage": "overlap",
      "coveredBy": "AIUsageClientTest.empty quotas array still replaces the previous snapshot",
      "note": "An empty quotas array is a successful snapshot, not a fatal decode.",
      "body": "{\"generated_at\":\"2020-01-01T00:00:00\",\"quotas\":[]}",
      "expect": {
        "outcome": "success"
      }
    },
    {
      "id": "missing_quotas_is_fatal",
      "coverage": "new",
      "note": "A missing quotas field is fatal for the whole response.",
      "body": "{\"generated_at\":\"2020-01-01T00:00:00\"}",
      "expect": {
        "outcome": "fatal",
        "fatalMessageContains": "not an array"
      }
    },
    {
      "id": "quotas_not_array_is_fatal",
      "coverage": "overlap",
      "coveredBy": "AIUsageClientTest.quotas field that is not an array is a fatal fetch failure",
      "note": "A quotas object is fatal. Included so the catalog states the non-array contract.",
      "body": "{\"quotas\":{\"provider\":\"test-a\"}}",
      "expect": {
        "outcome": "fatal",
        "fatalMessageContains": "not an array"
      }
    },
    {
      "id": "quotas_null_is_fatal",
      "coverage": "new",
      "note": "JSON null is not an array, so the fetch is fatal.",
      "body": "{\"quotas\":null}",
      "expect": {
        "outcome": "fatal",
        "fatalMessageContains": "not an array"
      }
    },
    {
      "id": "unkeyed_bad_items_are_fatal",
      "coverage": "overlap",
      "coveredBy": "AIUsageClientTest.unreadable quota items are a fatal fetch and keep the previous snapshot",
      "note": "null and {} have no readable provider/label, so they cannot enter failedKeys. If every item is like that, the fetch is fatal.",
      "body": "{\"quotas\":[null,{}]}",
      "expect": {
        "outcome": "fatal",
        "fatalMessageContains": "could not be decoded"
      }
    },
    {
      "id": "all_keyed_bad_items_is_partial_success",
      "coverage": "new",
      "note": "Every item fails to decode but each has a readable provider/label, so the fetch succeeds with no items and two failed keys. The P1-3 guard only fires when the array is non-empty, nothing decodes, AND no key is readable; a keyed all-bad payload is partial success, not fatal. This distinguishes an empty snapshot, a keyed partial failure (old value can be retained), and a fully unreadable fatal.",
      "body": "{\"quotas\":[{\"provider\":\"test-a\",\"label\":\"5h\",\"used_percentage\":\"oops\",\"remaining_percentage\":50},{\"provider\":\"test-b\",\"label\":\"7d\",\"used_percentage\":null,\"remaining_percentage\":50}]}",
      "expect": {
        "outcome": "success",
        "failed": [
          { "provider": "test-a", "label": "5h" },
          { "provider": "test-b", "label": "7d" }
        ]
      }
    }
  ]
