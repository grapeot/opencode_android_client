    {
      "id": "numeric_string_percentages_accepted",
      "coverage": "new",
      "note": "Policy lock: the client Json is ignoreUnknownKeys + isLenient, and quoted numeric percentage strings are accepted then rounded. Do not leave this to a library default.",
      "body": "{\"generated_at\":\"2020-01-01T00:00:00\",\"quotas\":[{\"provider\":\"test-a\",\"label\":\"5h\",\"used_percentage\":\"9.6\",\"remaining_percentage\":\"90.4\"}]}",
      "expect": {
        "outcome": "success",
        "items": [
          {
            "provider": "test-a",
            "label": "5h",
            "used": 10,
            "remaining": 90,
            "clampedUsed": 10,
            "clampedRemaining": 90
          }
        ]
      }
    },
    {
      "id": "non_finite_and_out_of_int_range",
      "coverage": "new",
      "note": "2147483648 and 1e100 are finite and fail in RoundedPercentageSerializer (out of range). 1e309, NaN, and Infinity are rejected by the default Json decoder before that serializer's finite guard; the consumer-visible result is still a per-item failedKey, not a fatal fetch. This fixture locks that layer split and does not claim the serializer guard saw NaN.",
      "body": "{\"generated_at\":\"2020-01-01T00:00:00\",\"quotas\":[{\"provider\":\"test-b\",\"label\":\"5h\",\"used_percentage\":11,\"remaining_percentage\":89,\"observed_at\":\"2023-11-14T22:13:19Z\"},{\"provider\":\"test-a\",\"label\":\"used-over-int\",\"used_percentage\":2147483648,\"remaining_percentage\":0},{\"provider\":\"test-a\",\"label\":\"rem-over-int\",\"used_percentage\":0,\"remaining_percentage\":2147483648},{\"provider\":\"test-a\",\"label\":\"used-1e100\",\"used_percentage\":1e100,\"remaining_percentage\":0},{\"provider\":\"test-a\",\"label\":\"used-1e309\",\"used_percentage\":1e309,\"remaining_percentage\":0},{\"provider\":\"test-a\",\"label\":\"used-nan\",\"used_percentage\":NaN,\"remaining_percentage\":0},{\"provider\":\"test-a\",\"label\":\"used-inf\",\"used_percentage\":Infinity,\"remaining_percentage\":0},{\"provider\":\"test-a\",\"label\":\"rem-inf\",\"used_percentage\":0,\"remaining_percentage\":Infinity},{\"provider\":\"test-c\",\"label\":\"7d\",\"used_percentage\":22,\"remaining_percentage\":78,\"observed_at\":\"2023-11-14T22:13:19Z\"}]}",
      "expect": {
        "outcome": "success",
        "assertFresh": true,
        "items": [
          {
            "provider": "test-b",
            "label": "5h",
            "used": 11,
            "remaining": 89,
            "clampedUsed": 11,
            "clampedRemaining": 89,
            "observedAt": "2023-11-14T22:13:19Z"
          },
          {
            "provider": "test-c",
            "label": "7d",
            "used": 22,
            "remaining": 78,
            "clampedUsed": 22,
            "clampedRemaining": 78,
            "observedAt": "2023-11-14T22:13:19Z"
          }
        ],
        "failed": [
          {
            "provider": "test-a",
            "label": "used-over-int",
            "layer": "serializer_range"
          },
          {
            "provider": "test-a",
            "label": "rem-over-int",
            "layer": "serializer_range"
          },
          {
            "provider": "test-a",
            "label": "used-1e100",
            "layer": "serializer_range"
          },
          {
            "provider": "test-a",
            "label": "used-1e309",
            "layer": "json_non_finite"
          },
          {
            "provider": "test-a",
            "label": "used-nan",
            "layer": "json_non_finite"
          },
          {
            "provider": "test-a",
            "label": "used-inf",
            "layer": "json_non_finite"
          },
          {
            "provider": "test-a",
            "label": "rem-inf",
            "layer": "json_non_finite"
          }
        ]
      },
      "fetchedAtMs": 1700000000000,
      "nowMs": 1700000001000,
      "observedAtEpochMs": 1699999999000
    },
