      "note": "Each percentage field is required. A bad value fails only that item when provider and label are readable. Healthy neighbors stay decoded and fresh.",
      "body": "{\"generated_at\":\"2020-01-01T00:00:00\",\"quotas\":[{\"provider\":\"test-b\",\"label\":\"5h\",\"used_percentage\":11,\"remaining_percentage\":89,\"observed_at\":\"2023-11-14T22:13:19Z\"},{\"provider\":\"test-a\",\"label\":\"used-null\",\"used_percentage\":null,\"remaining_percentage\":50},{\"provider\":\"test-a\",\"label\":\"rem-null\",\"used_percentage\":50,\"remaining_percentage\":null},{\"provider\":\"test-a\",\"label\":\"used-missing\",\"remaining_percentage\":50},{\"provider\":\"test-a\",\"label\":\"rem-missing\",\"used_percentage\":50},{\"provider\":\"test-a\",\"label\":\"used-object\",\"used_percentage\":{\"x\":1},\"remaining_percentage\":50},{\"provider\":\"test-a\",\"label\":\"rem-object\",\"used_percentage\":50,\"remaining_percentage\":{\"x\":1}},{\"provider\":\"test-a\",\"label\":\"used-bool\",\"used_percentage\":true,\"remaining_percentage\":50},{\"provider\":\"test-a\",\"label\":\"rem-bool\",\"used_percentage\":50,\"remaining_percentage\":false},{\"provider\":\"test-a\",\"label\":\"used-oops\",\"used_percentage\":\"oops\",\"remaining_percentage\":50},{\"provider\":\"test-a\",\"label\":\"rem-oops\",\"used_percentage\":50,\"remaining_percentage\":\"oops\"},{\"provider\":\"test-c\",\"label\":\"7d\",\"used_percentage\":22,\"remaining_percentage\":78,\"observed_at\":\"2023-11-14T22:13:19Z\"}]}",
      "expect": {
        "outcome": "success",
        "assertFresh": true,
