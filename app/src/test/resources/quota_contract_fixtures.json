      "coveredBy": "AIUsageClientTest compact contract already asserts absent observed_at and measurement_source are null; explicit nulls and usage/remaining/next_reset_time_ms are new",
      "note": "observed_at, measurement_source, next_reset_time_ms, usage, and remaining may be absent or JSON null.",
      "body": "{\"generated_at\":\"2020-01-01T00:00:00\",\"quotas\":[{\"provider\":\"test-a\",\"label\":\"missing\",\"used_percentage\":11,\"remaining_percentage\":89},{\"provider\":\"test-a\",\"label\":\"nulls\",\"used_percentage\":11,\"remaining_percentage\":89,\"observed_at\":null,\"measurement_source\":null,\"next_reset_time_ms\":null,\"usage\":null,\"remaining\":null}]}",
      "expect": {
